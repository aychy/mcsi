{
  // Do not set wrangler [build] to opennext here: CI already runs `npm run build` (Next + OpenNext).
  // A second OpenNext build during deploy corrupts `.open-next/cloudflare/next-env.mjs` (duplicate exports).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcsi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "mcsi"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
